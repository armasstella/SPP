<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.ProjectUpdateController"
            prefWidth="440" prefHeight="340"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header">
            <Label fx:id="lblTitle" text="ACTUALIZAR PROYECTO" styleClass="header-title"/>
            <Label fx:id="lblSubtitle" text="Modificar datos de un Proyecto" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="form-container" spacing="14" alignment="CENTER">
            <padding>
                <Insets top="36" bottom="20" left="48" right="48"/>
            </padding>

            <Label fx:id="lblMessageBeforeEdition" visible="true" managed="${lblMessageBeforeEdition.visible}"
                   text="De clic sobre el «Proyecto» que desea actualizar. Después de clic en Continuar." styleClass="lbl-status"/>
            <Label fx:id="lblMessageInEdition" visible="false" managed="${lblMessageInEdition.visible}"
                   text="Reemplace la información con la nueva." styleClass="lbl-status"/>

            <VBox fx:id="vbShowAllProjects" visible="true" VBox.vgrow="ALWAYS" managed="${vbShowAllProjects.visible}">
                <TableView fx:id="tblProjects" prefHeight="400">
                    <columns>
                        <TableColumn fx:id="colName" text="Nombre" prefWidth="120"
                                     sortable="false" reorderable="false"/>
                        <TableColumn fx:id="colDescription" text="Descripción" prefWidth="120"
                                     sortable="false" reorderable="false"/>
                        <TableColumn fx:id="colAvailability" text="Disponibilidad" prefWidth="120"
                                     sortable="false" reorderable="false"/>
                        <TableColumn fx:id="colPlacesAvailable" text="Cupo" prefWidth="120"
                                     sortable="false" reorderable="false"/>
                        <TableColumn fx:id="colLinkedOrganization" text="Organización Vinculada" prefWidth="120"
                                     sortable="false" reorderable="false"/>
                        <TableColumn fx:id="colProjectManager" text="Encargado de Proyecto" prefWidth="120"
                                     sortable="false" reorderable="false"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
            <VBox fx:id="vbEditProject" visible="false" managed="${vbEditProject.visible}" alignment="CENTER">
                <Label text="Nombre del Proyecto *" styleClass="field-label"/>
                <TextField fx:id="txtName" promptText="Ej. Sistema para Prácticas Profesionales"
                           styleClass="field-input"/>

                <Label text="Descripción *" styleClass="field-label"/>
                <TextArea fx:id="txtDescription" promptText="Ej. Desarrollo de software para..."
                           styleClass="field-input" VBox.vgrow="ALWAYS" wrapText="true"/>

                <Label text="Cupo *" styleClass="field-label"/>
                <TextField fx:id="txtPlacesAvailable" promptText="Ej. 4"
                           styleClass="field-input"/>
            </VBox>

            <Label fx:id="lblStatus" text="" styleClass="lbl-status" wrapText="true"/>
        </VBox>
    </center>

    <bottom>
        <VBox>
            <HBox fx:id="hbContinueButtons" visible="true" managed="${hbContinueButtons.visible}"
                  styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
                <padding>
                    <Insets top="12" bottom="16" left="48" right="48"/>
                </padding>
                <Button text="Cancelar" styleClass="btn-back" onAction="#cancel"/>
                <Button text="Continuar" styleClass="btn-primary"
                        onAction="#continueToEdit"/>
            </HBox>
            <HBox fx:id="hbEditionButtons" visible="false" managed="${hbEditionButtons.visible}"
                    styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
                <padding>
                    <Insets top="12" bottom="16" left="48" right="48"/>
                </padding>
                <Button text="Cancelar edición" styleClass="btn-back"
                        onAction="#cancelEdition"/>
                <Button text="Finalizar edición" styleClass="btn-primary"
                        onAction="#updateProject"/>
            </HBox>
        </VBox>

    </bottom>

</BorderPane>

