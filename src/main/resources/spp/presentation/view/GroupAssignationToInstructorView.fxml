<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.GroupAssignationToInstructorController"
            prefWidth="440" prefHeight="300"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header">
            <Label text="ASIGNACIÓN DE GRUPO" styleClass="header-title"/>
            <Label text="Asignar grupo a profesor" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="form-container" spacing="14" alignment="CENTER">
            <padding>
                <Insets top="36" bottom="20" left="48" right="48"/>
            </padding>

            <Label text="" styleClass="lbl-status"/>
            <TableView fx:id="tblCoordinators" prefHeight="400">
                <columns>
                    <TableColumn fx:id="clmnNRC" text="NRC" prefWidth="120"
                                 sortable="false" reorderable="false"/>
                    <TableColumn fx:id="clmnCapacity" text="Cupo" prefWidth="120"
                                 sortable="false" reorderable="false"/>
                    <TableColumn fx:id="clmnDetails" text="Detalles (Horario)" prefWidth="180"
                                 sortable="false" reorderable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <Label fx:id="lblStatus" text="" styleClass="lbl-status" wrapText="true"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="12" bottom="16" left="48" right="48"/></padding>
            <Button text="Cancelar" styleClass="btn-back" onAction="#cancel"/>
            <Button text="Continuar" styleClass="btn-danger" />
        </HBox>
    </bottom>

</BorderPane>