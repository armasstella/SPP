<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.GroupAssignationToInstructorController"
            prefWidth="480" prefHeight="520"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header">
            <Label text="ASIGNAR PROFESOR" styleClass="header-title"/>
            <Label text="Asignar profesor a curso (experiencia educativa)" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <StackPane>
            <VBox spacing="14" maxWidth="400" alignment="TOP_CENTER">
                <padding>
                    <Insets top="24" bottom="20" left="48" right="48"/>
                </padding>
                <ScrollPane>
                    <content>
                        <VBox spacing="14">
                            <padding>
                                <Insets left="5" right="5" top="5" bottom="5"/>
                            </padding>
                            <Label text="NRC *" styleClass="field-label"/>
                            <TextField fx:id="txtCourseCode" promptText="Ej. 13213" styleClass="field-input" editable="false"/>

                            <Label text="Período *" styleClass="field-label"/>
                            <TextField fx:id="txtTerm" promptText="" styleClass="field-input" editable="false"/>

                            <Label text="Bloque *" styleClass="field-label"/>
                            <TextField fx:id="txtSchoolBlock" promptText="" styleClass="field-input" editable="false"/>

                            <Label text="Sección *" styleClass="field-label"/>
                            <TextField fx:id="txtSection" promptText="" styleClass="field-input" editable="false"/>

                            <Label text="Profesor *" styleClass="field-label"/>
                            <ComboBox fx:id="cmbInstructor" promptText="Seleccione una opción"
                                      styleClass="field-input, combo-box-custom" maxWidth="Infinity"/>

                        </VBox>
                    </content>
                </ScrollPane>
                <Label fx:id="lblStatus" text="" styleClass="lbl-status" wrapText="true" alignment="CENTER"/>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding>
                <Insets top="12" bottom="16" left="48" right="48"/>
            </padding>
            <Button text="Cancelar" styleClass="btn-back" onAction="#cancel"/>
            <Button text="Asignar Profesor" styleClass="btn-add" onAction="#assignInstructor"/>
        </HBox>
    </bottom>

</BorderPane>