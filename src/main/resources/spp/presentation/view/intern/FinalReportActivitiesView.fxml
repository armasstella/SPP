<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="spp.presentation.controller.intern.FinalReportActivitiesController">

    <VBox styleClass="content-container" spacing="10">
        <padding><Insets top="20" right="32" bottom="16" left="32"/></padding>

        <Label fx:id="lblActivitiesCounter" text="0 actividades incluidas." styleClass="counter-label"/>

        <Label text="Actividades incluidas" styleClass="section-title"/>
        <TableView fx:id="tblIncludedActivities" styleClass="data-table" prefHeight="250">
            <columns>
                <TableColumn fx:id="colChosenActivityTitle" text="Título" prefWidth="120" reorderable="false"/>
                <TableColumn fx:id="colChosenActivityDescription" text="Descripción" prefWidth="180" reorderable="false"/>
                <TableColumn fx:id="colChosenActivityStartDate" text="Fecha Inicio" prefWidth="90" reorderable="false"/>
                <TableColumn fx:id="colChosenActivityEndDate" text="Fecha Fin" prefWidth="90" reorderable="false"/>
                <TableColumn fx:id="colChosenActivityEstimatedTime" text="T. Estimado" prefWidth="90" reorderable="false"/>
                <TableColumn fx:id="colChosenActivityEffectiveTime" text="T. Efectivo" prefWidth="90" reorderable="false"/>
                <TableColumn fx:id="colChosenActivityProgress" text="Avance %" prefWidth="80" reorderable="false"/>
                <TableColumn fx:id="colChosenActivityObservations" text="Observaciones" prefWidth="180" reorderable="false"/>
            </columns>
        </TableView>

        <Label text="Actividades realizadas" styleClass="section-title"/>
        <TableView fx:id="tblActivities" styleClass="data-table" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Sin registros" styleClass="field-label"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colActivityTitle" text="Título"
                             prefWidth="120"
                             reorderable="false"/>
                <TableColumn fx:id="colActivityDescription" text="Descripción"
                             prefWidth="180"
                             reorderable="false"/>
                <TableColumn fx:id="colActivityStartDate" text="Fecha Inicio"
                             prefWidth="90"
                             reorderable="false"/>
                <TableColumn fx:id="colActivityEndDate" text="Fecha Fin"
                             prefWidth="90"
                             reorderable="false"/>
                <TableColumn fx:id="colActivityEstimatedTime" text="T. Estimado"
                             prefWidth="90"
                             reorderable="false"/>
                <TableColumn fx:id="colActivityEffectiveTime" text="T. Efectivo"
                             prefWidth="90"
                             reorderable="false"/>
                <TableColumn fx:id="colActivityProgress" text="Avance %"
                             prefWidth="80"
                             reorderable="false"/>
                <TableColumn fx:id="colActivityObservations" text="Observaciones"
                             prefWidth="180"
                             reorderable="false"/>
            </columns>
        </TableView>
    </VBox>

</VBox>