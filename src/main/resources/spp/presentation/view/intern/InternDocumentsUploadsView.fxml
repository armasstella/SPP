<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="spp.presentation.controller.instructor.InternDocumentsUploadsController"
      spacing="15" prefWidth="320" styleClass="sidebar-section">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <VBox spacing="5" styleClass="info-box">
        <Label text="SE DESPLIEGA LA DOCUMENTACIÓN SUBIDA" styleClass="section-subtitle" wrapText="true"/>
    </VBox>

    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="Practicantes Asignados" styleClass="section-subtitle"/>
        <TableView fx:id="tblInternProgress" VBox.vgrow="ALWAYS" styleClass="custom-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label text="Sin registros de documentos" styleClass="field-label"/>
            </placeholder>

            <columns>

                <TableColumn fx:id="colDocumentType" text="Documento"
                             prefWidth="150"
                             reorderable="false"/>

                <TableColumn fx:id="colGrade" text="Calificación"
                             prefWidth="150"
                             reorderable="false"/>

                <TableColumn fx:id="colObservations" text="Observaciones"
                             prefWidth="150"
                             reorderable="false"/>

                <TableColumn fx:id="colRevisionDate" text="Fecha de revisión"
                             prefWidth="150"
                             reorderable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>



