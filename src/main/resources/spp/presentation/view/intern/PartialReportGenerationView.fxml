<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.intern.PartialReportGenerationController"
            prefWidth="760" prefHeight="720"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header">
            <Label text="Generar Informe Parcial" styleClass="header-title"/>
            <Label text="Captura la información del informe parcial" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox styleClass="content-container" spacing="12" alignment="CENTER" HBox.hgrow="ALWAYS" maxWidth="600">
                    <padding><Insets top="20" right="32" bottom="16" left="32"/></padding>

                    <Label text="Datos del practicante" styleClass="section-title"/>
                    <Label text="Alumno:" styleClass="field-label"/>
                    <Label fx:id="lblStudentName" styleClass="field-value"/>
                    <Label text="Matrícula:" styleClass="field-label"/>
                    <Label fx:id="lblStudentNumber" styleClass="field-value"/>
                    <Label text="Proyecto:" styleClass="field-label"/>
                    <Label fx:id="lblProjectName" styleClass="field-value"/>
                    <Label text="Organización vinculada:" styleClass="field-label"/>
                    <Label fx:id="lblLinkedOrganization" styleClass="field-value"/>

                    <Label text="Datos del informe" styleClass="section-title"/>
                    <Label text="Número del informe" styleClass="field-label"/>
                    <TextField fx:id="txtReportNumber" styleClass="field-input"/>
                    <Label text="Período del reporte" styleClass="field-label"/>
                    <TextField fx:id="txtTerm" editable="false" styleClass="field-input"/>
                    <Label text="Objetivo general del proyecto" styleClass="field-label"/>
                    <TextArea fx:id="taObjective" styleClass="field-input"/>
                    <Label text="Metodología" styleClass="field-label"/>
                    <TextArea fx:id="taMethodology" styleClass="field-input"/>

                    <Label text="Agregar actividad" styleClass="section-title"/>
                    <Label text="Nombre de la actividad" styleClass="field-label"/>
                    <TextField fx:id="txtActivityName" styleClass="field-input"/>
                    <Label text="Descripción" styleClass="field-label"/>
                    <TextArea fx:id="taActivityDescription" styleClass="field-input"/>
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Semana (1-8)" styleClass="field-label"/>
                            <ComboBox fx:id="cmbWeek" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Tiempo planeado" styleClass="field-label"/>
                            <TextField fx:id="txtPlannedTime" styleClass="field-input"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Tiempo real" styleClass="field-label"/>
                            <TextField fx:id="txtRealTime" styleClass="field-input"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Agregar actividad" styleClass="btn-add" onAction="#addActivity"/>
                    </HBox>

                    <Label text="Actividades agregadas" styleClass="section-title"/>
                    <ListView fx:id="lvActivities" styleClass="data-table" prefHeight="160"/>

                    <Label text="Resultados obtenidos al momento" styleClass="field-label"/>
                    <TextArea fx:id="taResults" styleClass="field-input"/>
                    <Label text="Observaciones" styleClass="field-label"/>
                    <TextArea fx:id="taObservations" styleClass="field-input"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="12" right="32" bottom="16" left="32"/></padding>
            <Label fx:id="lblStatus" text="" styleClass="lbl-status" wrapText="true" HBox.hgrow="ALWAYS"/>
            <Button text="Regresar" styleClass="btn-back" onAction="#goToInternMenuView"/>
            <Button fx:id="btnGenerate" text="Generar informe" styleClass="btn-add" onAction="#generatePartialReport"/>
        </HBox>
    </bottom>

</BorderPane>
