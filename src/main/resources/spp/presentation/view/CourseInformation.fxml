<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.StackPane?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.CoordinatorMenuController"
            prefWidth="520" prefHeight="440"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header">
            <Label text="INFORMACIÓN DE CURSOS" styleClass="header-title-module"/>
            <Label text="Catálago y búsqueda de cursos registrados" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <StackPane>
            <VBox spacing="20">
                <padding>
                    <Insets top="24" bottom="20" left="48" right="48"/>
                </padding>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <TextField fx:id="txtSearch" promptText="Buscar producto" styleClass="field-input" prefWidth="300"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Registrar Curso" styleClass="btn-save" onAction="#goToNewCourseView"/>
                </HBox>

                <TableView fx:id="tblCourses" VBox.vgrow="ALWAYS" styleClass="custom-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <placeholder>
                        <Label text="Sin registros" styleClass="field-label"/>
                    </placeholder>

                    <columns>
                        <TableColumn fx:id="colCourseCode" text="NRC"
                                     prefWidth="100" minWidth="100" maxWidth="100"
                                     reorderable="false"/>

                        <TableColumn fx:id="colTerm" text="Periodo"
                                     prefWidth="180"
                                     reorderable="false"/>

                        <TableColumn fx:id="colSchoolBlock" text="Bloque"
                                     prefWidth="100" minWidth="100" maxWidth="100"
                                     reorderable="false"/>

                        <TableColumn fx:id="colSection" text="Sección"
                                     prefWidth="100"
                                     reorderable="false"/>

                        <TableColumn fx:id="colInstructor" text="Profesor"
                                     prefWidth="100" minWidth="100" maxWidth="100"
                                     reorderable="false"/>

                        <TableColumn fx:id="colNumberOfInterns" text="Cant. Estudiantes"
                                     prefWidth="100"
                                     reorderable="false"/>

                    </columns>
                </TableView>
                <VBox spacing="14">
                    <padding>
                        <Insets left="5" right="5" top="5" bottom="5"/>
                    </padding>
                </VBox>
                <Label fx:id="lblStatus" text="" styleClass="lbl-status" wrapText="true" alignment="CENTER"/>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding>
                <Insets top="14" bottom="14" left="48" right="48"/>
            </padding>
            <Button text="Regresar" styleClass="btn-back" onAction="#goBackToMenu"/>
        </HBox>
    </bottom>

</BorderPane>
