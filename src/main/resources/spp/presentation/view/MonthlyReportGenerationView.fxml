<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.MonthlyReportGenerationController"
            prefWidth="680" prefHeight="700"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header">
            <Label text="Generar Reporte Mensual" styleClass="header-title"/>
            <Label text="Seleccione actividades para generar reporte" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-container" spacing="10">
            <padding><Insets top="20" right="32" bottom="16" left="32"/></padding>

            <Label fx:id="lblCounter" text="0 actividades incluidas." styleClass="counter-label"/>

            <Label text="Actividades incluidas" styleClass="section-title"/>
            <TableView fx:id="tblIncludedActivities" styleClass="data-table" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colChosenActivityTitle" text="Título"
                                 prefWidth="100" minWidth="100" maxWidth="100"
                                 reorderable="false"/>

                    <TableColumn fx:id="colChosenActivityDescription" text="Descripción"
                                 prefWidth="180"
                                 reorderable="false"/>

                    <TableColumn fx:id="colChosenActivityStartDate" text="Fecha Inicio"
                                 prefWidth="180"
                                 reorderable="false"/>

                    <TableColumn fx:id="colChosenActivityEndDate" text="Fecha Fin"
                                 prefWidth="100" minWidth="100" maxWidth="100"
                                 reorderable="false"/>
                </columns>
            </TableView>

            <Label text="Actividades realizadas" styleClass="section-title"/>
            <TableView fx:id="tblActivities" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <placeholder>
                    <Label text="Sin registros" styleClass="field-label"/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="colTitle" text="Título"
                                 prefWidth="100" minWidth="100" maxWidth="100"
                                 reorderable="false"/>

                    <TableColumn fx:id="colDescription" text="Descripción"
                                 prefWidth="180"
                                 reorderable="false"/>

                    <TableColumn fx:id="colStartDate" text="Fecha Inicio"
                                 prefWidth="180"
                                 reorderable="false"/>

                    <TableColumn fx:id="colEndDate" text="Fecha Fin"
                                 prefWidth="100" minWidth="100" maxWidth="100"
                                 reorderable="false"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="12" right="32" bottom="16" left="32"/></padding>
            <Label fx:id="lblStatus" text="" styleClass="lbl-status" wrapText="true" HBox.hgrow="ALWAYS"/>
            <Button text="Regresar" styleClass="btn-back" onAction="#goToInternMenuView"/>
            <Button text="Generar reporte" styleClass="btn-add" onAction="#generateReport"/>
        </HBox>
    </bottom>

</BorderPane>
