<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="spp.presentation.controller.instructor.InternSelectorController"
      spacing="15" prefWidth="320" styleClass="sidebar-section">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <VBox spacing="5" styleClass="info-box">
        <Label text="SE DESPLIEGAN POR PRIORIDAD PRACTICANTES CON DOCUMENTACIÓN SUBIDA" styleClass="section-subtitle" wrapText="true"/>
    </VBox>

    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="Practicantes Asignados" styleClass="section-subtitle"/>
        <TableView fx:id="tblInterns" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" text="Nombre" prefWidth="180" sortable="false" reorderable="false"/>
                <TableColumn fx:id="colStatus" text="Estado Docs" prefWidth="110" sortable="false" reorderable="false"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>