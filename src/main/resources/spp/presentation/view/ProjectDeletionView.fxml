<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.ProjectDeletionController"
            prefWidth="440" prefHeight="340"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header">
            <Label fx:id="lblTitle" text="ELIMINAR PROYECTO" styleClass="header-title"/>
            <Label fx:id="lblSubtitle" text="Eliminar un Proyecto permanentemente"
                   styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="form-container" spacing="14" alignment="CENTER">
            <padding>
                <Insets top="36" bottom="20" left="48" right="48"/>
            </padding>

            <Label text="Dé clic sobre el proyecto que desea eliminar" styleClass="lbl-status"/>
            <TableView fx:id="tblProjects" prefHeight="400">
                <columns>
                    <TableColumn fx:id="clmnName" text="Nombre" prefWidth="120"
                                 sortable="false" reorderable="false"/>
                    <TableColumn fx:id="clmnDescription" text="Descripción" prefWidth="120"
                                 sortable="false" reorderable="false"/>
                    <TableColumn fx:id="clmnAvailibility" text="Disponibilidad" prefWidth="120"
                                 sortable="false" reorderable="false"/>
                    <TableColumn fx:id="clmnOrganization" text="Organización" prefWidth="120"
                                 sortable="false" reorderable="false"/>
                    <TableColumn fx:id="clmnManager" text="Encargado" prefWidth="120"
                                 sortable="false" reorderable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <Label fx:id="lblStatus" text="" styleClass="lbl-status" wrapText="true"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding>
                <Insets top="12" bottom="16" left="48" right="48"/>
            </padding>
            <Button text="Cancelar" styleClass="btn-back" onAction="#cancel"/>
            <Button fx:id="btnConfirm" text="Eliminar" styleClass="btn-primary"
                    onAction="#deleteProject"/>
        </HBox>
    </bottom>
</BorderPane>
