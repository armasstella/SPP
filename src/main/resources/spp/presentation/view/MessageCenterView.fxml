<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.MessageCenterController"
            prefWidth="900" prefHeight="600"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header" spacing="5">
            <Label text="CENTRO DE MENSAJES" styleClass="header-title"/>
            <Label text="Consulte sus mensajes" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="48" bottom="20" left="48"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <Button text="&lt;– Regresar a menú principal" styleClass="btn-back" onAction="#goToMenuView"/>
            </HBox>


            <HBox spacing="30" VBox.vgrow="ALWAYS">
                <VBox fx:id="vbOptions" spacing="15" prefWidth="270">
                    <Button text="+ Nuevo mensaje" styleClass="option-btn, btn-primary" maxWidth="Infinity" onAction="#showNewMessageForm"/>
                    <Button text="Todos los mensajes" styleClass="option-btn, btn-activate" maxWidth="Infinity" onAction="#showAllMessages"/>
                    <Button text="No leídos" styleClass="option-btn, btn-activate" maxWidth="Infinity"/>
                    <Button text="Enviados" styleClass="option-btn, btn-activate" maxWidth="Infinity"/>
                </VBox>

                <VBox fx:id="vbOptionSelected" HBox.hgrow="ALWAYS">
                    <VBox fx:id="vbOptionAllMessages" visible="true" VBox.vgrow="ALWAYS" managed="${vbOptionAllMessages.visible}">
                        <TableView fx:id="tblMessages" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="clmnSender" text="Correo remitente" prefWidth="200"
                                             sortable="false" reorderable="false"/>
                                <TableColumn fx:id="clmnSubject" text="Asunto" prefWidth="250"
                                             sortable="false" reorderable="false"/>
                                <TableColumn fx:id="clmnDate" text="Fecha" prefWidth="150"
                                             sortable="false" reorderable="false"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <VBox fx:id="vbOptionNewMessage" visible="false" managed="${vbOptionNewMessage.visible}" spacing="20">
                        <Label text="REDACTAR NUEVO MENSAJE" styleClass="field-label"/>

                        <VBox spacing="5">
                            <Label text="Destinatario (Correo):" styleClass="field-description"/>
                            <TextField fx:id="txtRecipient" promptText="ejemplo@correo.com" styleClass="field-input" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Asunto:" styleClass="field-description"/>
                            <TextField fx:id="txtSubject" promptText="Ingrese el asunto" styleClass="field-input" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="5" VBox.vgrow="ALWAYS">
                            <Label text="Mensaje:" styleClass="field-description"/>
                            <TextArea fx:id="txtBody" promptText="Escriba su mensaje aquí..." styleClass="field-input" VBox.vgrow="ALWAYS" wrapText="true"/>
                        </VBox>

                        <HBox alignment="BOTTOM_RIGHT" spacing="15">
                            <Button text="Cancelar" styleClass="btn-danger" onAction="#showAllMessages"/>
                            <Button text="Enviar Mensaje" styleClass="btn-primary" onAction="#sendMessage"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="vbOtpionMessagesNoRead" visible="false" managed="${vbOtpionMessagesNoRead.visible}">

                    </VBox>

                    <VBox fx:id="vbOptionSendedMessage" visible="false" managed="${vbOptionSendedMessage.visible}">

                    </VBox>
                </VBox>

            </HBox>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblStatus" text="" styleClass="lbl-status" wrapText="true"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>