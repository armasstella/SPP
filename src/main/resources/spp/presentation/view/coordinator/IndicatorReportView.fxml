<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.coordinator.IndicatorReportController"
            prefWidth="680" prefHeight="500"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header">
            <Label text="Generar Reporte de Indicadores" styleClass="header-title"/>
            <Label text="Aplique los filtros necesarios para consultar las estadísticas del sistema" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-container" spacing="15">
            <padding><Insets top="20" right="32" bottom="20" left="32"/></padding>

            <Label text="Filtros Disponibles" styleClass="section-title"/>

            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="70"/>
                </columnConstraints>

                <Label text="Período Escolar:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="field-label"/>
                <ComboBox fx:id="cmbFilterPeriod" GridPane.columnIndex="1"
                          GridPane.rowIndex="0" styleClass="combo-box-custom" prefWidth="250"/>

                <Label text="Género:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="field-label"/>
                <ComboBox fx:id="cmbFilterGender" GridPane.columnIndex="1"
                          GridPane.rowIndex="1" styleClass="combo-box-custom" prefWidth="250"/>

                <Label text="Lengua Indígena:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="field-label"/>
                <ComboBox fx:id="cmbFilterLanguage" GridPane.columnIndex="1"
                          GridPane.rowIndex="2" styleClass="combo-box-custom" prefWidth="250"/>

                <Label text="Rango de Edad:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="field-label"/>
                <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <TextField fx:id="txtFilterMinAge" promptText="Mínima" styleClass="field-input" prefWidth="100"/>
                    <Label text=" - " styleClass="field-value"/>
                    <TextField fx:id="txtFilterMaxAge" promptText="Máxima" styleClass="field-input" prefWidth="100"/>
                </HBox>
            </GridPane>

        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="12" right="32" bottom="16" left="32"/></padding>
            <Label fx:id="lblStatus" text="" styleClass="lbl-status" wrapText="true" HBox.hgrow="ALWAYS"/>
            <Button text="Cancelar" styleClass="btn-back" onAction="#goToCoordinatorMenuView"/>
            <Button text="Generar PDF" styleClass="btn-add" onAction="#generateReport"/>
        </HBox>
    </bottom>
</BorderPane>