<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.coordinator.NewLinkedOrganizationController"
            minWidth="720" minHeight="520"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header">
            <Label text="REGISTRAR ORGANIZACIÓN" styleClass="header-title"/>
            <Label text="Nueva Organización" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <StackPane>
            <VBox spacing="14" maxWidth="400" alignment="TOP_CENTER">
                <padding>
                    <Insets top="24" bottom="20" left="48" right="48"/>
                </padding>
                    <ScrollPane>
                        <content>
                            <VBox spacing="14">
                                <padding>
                                    <Insets left="5" right="5" top="5" bottom="5"/>
                                </padding>
                                    <Label text="Nombre de la organización *" styleClass="field-label"/>
                                    <TextField fx:id="txtName" promptText="Ej. Aceites Palma A.C., C.V."
                                               styleClass="field-input"/>

                                    <Label text="RFC *" styleClass="field-label"/>
                                    <TextField fx:id="txtRfc" promptText="Ej. PAM130316E60" styleClass="field-input"/>

                                    <Label text="Dirección *" styleClass="field-label"/>
                                    <TextField fx:id="txtAddress" promptText="Ej. Guadalupe Victoria 419"
                                               styleClass="field-input"/>

                                    <Label text="Dirección Fiscal *" styleClass="field-label"/>
                                    <TextField fx:id="txtFiscalAddress" promptText="Ej. Guadalupe Victoria 419"
                                               styleClass="field-input"/>

                                    <Label text="Giro de la organización *" styleClass="field-label"/>
                                    <TextField fx:id="txtBusiness" promptText="Ej. Industrial"
                                               styleClass="field-input"/>

                                    <Label text="Teléfono *" styleClass="field-label"/>
                                    <TextField fx:id="txtPhoneNumber" promptText="228 111 2222"
                                               styleClass="field-input"/>

                                    <Label text="Correo electrónico *" styleClass="field-label"/>
                                    <TextField fx:id="txtEmail" promptText="correo@uv.mx" styleClass="field-input"/>
                            </VBox>
                        </content>
                    </ScrollPane>
            </VBox>
            <Label fx:id="lblStatus" text=""
                   styleClass="lbl-status"
                   alignment="CENTER"
                   StackPane.alignment= "BOTTOM_CENTER"
                   wrapText="true"
                   maxWidth="400"/>
            <StackPane.margin>
                <Insets bottom="12" left="48" right="48"/>
            </StackPane.margin>
        </StackPane>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding>
                <Insets top="12" bottom="16" left="48" right="48"/>
            </padding>
            <Button text="Cancelar" styleClass="btn-back" onAction="#cancel"/>
            <Button text="Registrar" styleClass="btn-primary" onAction="#saveLinkedOrganization"/>
        </HBox>
    </bottom>
</BorderPane>
