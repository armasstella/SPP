<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="spp.presentation.controller.coordinator.InternTrackingController"
            minWidth="720" minHeight="520"
            styleClass="root-pane"
            stylesheets="@/spp/presentation/css/MainStyle.css">

    <top>
        <VBox styleClass="header">
            <Label text="SEGUIMIENTO DE PRACTICANTES" styleClass="header-title"/>
            <Label text="Consulta del estado y proyectos de los estudiantes inscritos" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <StackPane>
            <VBox spacing="20">
                <padding>
                    <Insets top="24" bottom="20" left="48" right="48"/>
                </padding>

                <TableView fx:id="tblInterns" VBox.vgrow="ALWAYS" styleClass="custom-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <placeholder>
                        <Label text="Sin registros de practicantes" styleClass="field-label"/>
                    </placeholder>

                    <columns>
                        <TableColumn fx:id="colStudentNumber" text="Matrícula"
                                     prefWidth="100" minWidth="100" maxWidth="100"
                                     reorderable="false"/>

                        <TableColumn fx:id="colFullName" text="Nombre Completo"
                                     prefWidth="180"
                                     reorderable="false"/>

                        <TableColumn fx:id="colEmail" text="Correo Electrónico"
                                     prefWidth="150"
                                     reorderable="false"/>

                        <TableColumn fx:id="colAssignedProject" text="Proyecto"
                                     prefWidth="150"
                                     reorderable="false"/>

                        <TableColumn fx:id="colProjectAddress" text="Dirección"
                                     prefWidth="150"
                                     reorderable="false"/>

                        <TableColumn fx:id="colCompletedHours" text="Horas"
                                     prefWidth="80" minWidth="80" maxWidth="80"
                                     reorderable="false"/>

                        <TableColumn fx:id="colPhaseStatus" text="Estado"
                                     prefWidth="100" minWidth="100" maxWidth="120"
                                     reorderable="false"/>
                    </columns>
                </TableView>

                <VBox spacing="14">
                    <padding>
                        <Insets left="5" right="5" top="5" bottom="5"/>
                    </padding>
                </VBox>

                <Label fx:id="lblStatus" text="" styleClass="lbl-status" wrapText="true" alignment="CENTER"/>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding>
                <Insets top="14" bottom="14" left="48" right="48"/>
            </padding>
            <Button text="Regresar" styleClass="btn-back" onAction="#goBackToMenu"/>
        </HBox>
    </bottom>

</BorderPane>